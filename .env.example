# Local demonstration login. These values work on a local laptop only.
# Change all values before sharing a deployment with other people.
AQUA_SESSION_SECRET=replace-with-a-long-random-secret
AQUA_ADMIN_USERNAME=admin
AQUA_ADMIN_PASSWORD=admin123
AQUA_USER_USERNAME=user
AQUA_USER_PASSWORD=user123

# Optional: Aqua Copilot uses a source-grounded fallback when this is blank.
# Leave this blank for the local demonstration. A paid ChatGPT subscription is
# not needed to run the dashboard or its deterministic prediction model.
OPENAI_API_KEY=
OPENAI_RAG_MODEL=gpt-5.6-sol

# Optional durable report storage. Keep this server-only key out of the browser,
# Git history and any NEXT_PUBLIC_ environment variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
