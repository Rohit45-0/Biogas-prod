AQUA_SESSION_SECRET=replace-with-a-long-random-secret
AQUA_ADMIN_USERNAME=admin
AQUA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AQUA_USER_USERNAME=user
AQUA_USER_PASSWORD=replace-with-a-strong-user-password

# Local development only. Production uses a linked PRIVATE Vercel Blob store.
AQUA_AUDIT_DIR=test-results/local-store
# BLOB_READ_WRITE_TOKEN is injected by the private Blob project integration.

# Optional. Without this key, Copilot uses the built-in keyword fallback.
OPENAI_API_KEY=
OPENAI_RAG_MODEL=gpt-5.6-sol
