# Local demonstration values only. This file contains no real API key.
# The launcher copies it to .env.local, which Git deliberately ignores.
# For a shared deployment, use unique passwords and a long random session secret.
AQUA_SESSION_SECRET=local-demo-secret-change-before-deployment
AQUA_ADMIN_USERNAME=admin
AQUA_ADMIN_PASSWORD=admin123
AQUA_USER_USERNAME=user
AQUA_USER_PASSWORD=user123

# Optional for the dashboard. Paste the client's OpenAI API key after the '='.
# If left empty, Aqua Copilot still works using its built-in evidence fallback.
OPENAI_API_KEY=
OPENAI_RAG_MODEL=gpt-5.6-sol
